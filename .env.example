# Copy to .env and fill in values. Do not commit .env.

# Supabase (required)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Site URLs (your live shop)
VITE_SITE_URL="https://https-www-asperbeautyshop-com.lovable.app"
VITE_LOVABLE_URL="https://https-www-asperbeautyshop-com.lovable.app"

# Shopify (cart + checkout) — from Shopify Admin → Settings → Apps → Develop apps → Storefront API
VITE_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
VITE_SHOPIFY_STORE="your-store.myshopify.com"
VITE_SHOPIFY_API_VERSION="2025-07"
VITE_SHOPIFY_STOREFRONT_TOKEN="your-storefront-access-token"

# hCaptcha (auth forms) — https://hcaptcha.com
VITE_HCAPTCHA_SITE_KEY=""

# Gemini (Asper Intelligence page) — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=""
