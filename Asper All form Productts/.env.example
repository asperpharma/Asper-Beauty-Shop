# Copy to .env and fill in your values. Never commit .env to git.
#
# Validation (React 18 + Vite stack):
# 1. Prefix: Use VITE_ for all client-side variables. NEXT_PUBLIC_ will NOT be exposed in this project.
# 2. Security: Never commit .env. Only this .env.example belongs in the repo. Set real values in local .env and in deployment (Vercel/Lovable) env settings.
# 3. Supabase: Prefer VITE_SUPABASE_PUBLISHABLE_KEY (primary for Edge Functions / Centralised Brain). VITE_SUPABASE_ANON_KEY is an optional fallback.
#
# Full setup guide: docs/SETUP_COMPLETE.md

# ============ Supabase ============
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_TRAY_URL=https://your-project-id.supabase.co/functions/v1/tray

# ============ Shopify Storefront API ============
VITE_SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
VITE_SHOPIFY_STOREFRONT_API_TOKEN=your-public-storefront-token
VITE_SHOPIFY_API_VERSION=2025-01
VITE_SHOPIFY_CHECKOUT_URL=https://your-store.myshopify.com/cart

# ============ Feature Flags ============
VITE_APP_ENV=development

# ============ Supabase Edge Function Secrets (Dashboard only, not in .env) ============
# Add these in Supabase → Settings → Edge Functions → Secrets:
#   GEMINI_API_KEY            - for beauty-assistant (from aistudio.google.com)
#   GEMINI_MODEL              - optional, default: gemini-2.0-flash
#   SHOPIFY_STORE_DOMAIN      - for shopify-discovery, get-products-by-concern
#   SHOPIFY_STOREFRONT_API_TOKEN or SHOPIFY_STOREFRONT_TOKEN - for Shopify API calls
#
# Re-run docs/STEP_BY_STEP.md "Completion checklist" when you change hosting, env, or Supabase.
